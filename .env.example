# Copy to .env for local development. Production values are set in the deploy environment.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:pass@localhost:5432/cheapskate
DATABASE_SSL=false
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_EXPIRY=15m

# JWT keys: provide either file paths or the PEM contents (use \n for newlines).
PRIVATE_KEY_PATH=./src/keys/private.pem
PUBLIC_KEY_PATH=./src/keys/public.pem
# PRIVATE_KEY=
# PUBLIC_KEY=
